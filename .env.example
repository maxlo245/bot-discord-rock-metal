# ─── DISCORD ─────────────────────────────────────────────────────────────────
# Token de ton bot (Discord Developer Portal)
DISCORD_TOKEN=ton_token_discord_ici

# ID de ton application Discord
DISCORD_CLIENT_ID=ton_client_id_ici

# ID de ton serveur Discord (supprime les anciennes commandes locales en double)
DISCORD_GUILD_ID=1507524438235549727

# ─── SPOTIFY ──────────────────────────────────────────────────────────────────
# Créé sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=ton_spotify_client_id
SPOTIFY_CLIENT_SECRET=ton_spotify_client_secret

# ─── LAST.FM ──────────────────────────────────────────────────────────────────
# Clé API sur https://www.last.fm/api/account/create
LASTFM_API_KEY=ta_clé_lastfm

# ─── PARAMÈTRES ───────────────────────────────────────────────────────────────
# Intervalle RSS en minutes (défaut: 2, maximum effectif: 5 pour les alertes urgentes)
RSS_INTERVAL_MINUTES=2

# Heure et fuseau du récapitulatif quotidien (une fois par 24 h)
DAILY_DIGEST_HOUR=19
DAILY_DIGEST_TIMEZONE=Europe/Paris

# Intervalle Spotify en minutes (défaut: 60)
SPOTIFY_INTERVAL_MINUTES=60

# Intervalle Metal Archives en minutes (défaut: 120)
METALARCHIVES_INTERVAL_MINUTES=120

# Intervalle Last.fm en minutes (défaut: 60)
LASTFM_INTERVAL_MINUTES=60
